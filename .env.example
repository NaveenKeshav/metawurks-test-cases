# MetaWurks App Configuration (dev2 deployment of metawurks-frontend-webapp-v2)
BASE_URL=https://dev2.metawurks.com
APP_URL=https://dev2.metawurks.com

# Timeout Configuration (in milliseconds)
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=15000

# Viewport Configuration
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900

# Test Configuration
RETRY_COUNT=0
WORKER_COUNT=undefined

# Login Credentials (for successful login test)
LOGIN_USERNAME=user_mail_address
LOGIN_PASSWORD=user_password
